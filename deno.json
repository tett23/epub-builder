{
  "license": "MIT",
  "tasks": {
    "check": "deno check scripts/ test/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --allow-read --allow-run=git test/"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1",
    "@std/testing": "jsr:@std/testing@^1"
  }
}
