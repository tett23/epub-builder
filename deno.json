{
  "license": "MIT",
  "tasks": {
    "check": "deno check mod.ts load.ts src/ scripts/ test/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --allow-read --allow-write --allow-run=git test/",
    "build:sample": "deno run --allow-read --allow-write scripts/build-sample.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      "test/fixtures/"
    ]
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1",
    "@std/testing": "jsr:@std/testing@^1",
    "hast": "npm:@types/hast@3.0.5",
    "mdast": "npm:@types/mdast@4.0.4",
    "hastscript": "npm:hastscript@9.0.1",
    "mdast-util-gfm-footnote": "npm:mdast-util-gfm-footnote@2.1.0",
    "micromark-extension-gfm-footnote": "npm:micromark-extension-gfm-footnote@2.1.0",
    "property-information": "npm:property-information@7.2.0",
    "rehype-parse": "npm:rehype-parse@9.0.1",
    "rehype-raw": "npm:rehype-raw@7.0.0",
    "remark-parse": "npm:remark-parse@11.0.0",
    "remark-rehype": "npm:remark-rehype@11.1.2",
    "unified": "npm:unified@11.0.5"
  }
}
