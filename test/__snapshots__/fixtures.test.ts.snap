== OEBPS/text/0002.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head>
<title>Introduction</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Introduction</h1>
<h2>Scope {#not-an-id-in-commonmark}</h2>
<p id="scope">This book is <em>synthetic</em>.</p>
<p>It exercises reference links like <a href="https://example.com/spec" title="Specification">the spec</a>,
autolinks like <a href="https://example.com/epub">https://example.com/epub</a>, and links to <a href="0004.xhtml#tree">basics</a>.</p>
<p>Inline <code>code &lt;with&gt; &amp; entities</code>, <em>emphasis</em>, <strong>strong</strong>, and a hard break<br/>
on the next line.</p>
<p><img src="../assets/diagrams/flow.svg" alt="A flow diagram"/></p>
</body>
</html>

== OEBPS/text/0003.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head>
<title>Part I: Basics</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Part I: Basics</h1>
</body>
</html>

== OEBPS/text/0004.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head>
<title>Directory layout</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Directory layout</h1>
<pre id="tree">project/
  book.toml
  body/
  meta/
  assets/</pre>
<pre><code class="language-toml">title = "x &lt; y &amp;&amp; z"
</code></pre>
<ol>
<li>Write <code>book.toml</code>.</li>
<li>Add documents to <code>body/</code>.
<ul>
<li>Nested list item.</li>
<li>Another one.</li>
</ul>
</li>
<li>Build.</li>
</ol>
<blockquote>
<p><strong>Note:</strong> a blockquote with a <a href="0002.xhtml">link back</a>.</p>
</blockquote>
</body>
</html>

== OEBPS/text/0005.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head>
<title>Ordering</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Ordering</h1>
<table>
  <thead><tr><th>Name</th><th>Position</th></tr></thead>
  <tbody><tr><td><code>01-a.md</code></td><td>1
  </td></tr><tr><td><code>02-b.md</code></td><td>2
  </td></tr><tr><td><code>10-c.md</code></td><td>3
</td></tr></tbody></table>
<p>Names are compared by code point — not “naturally”.
</p><p><img src="../assets/diagrams/flow.svg" alt="flow"/>
</p>
</body>
</html>

== OEBPS/text/0006.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head>
<title>Namespaces</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1 id="ns">Namespaces</h1>
<p xml:lang="ja">日本語の段落。<span lang="en" xml:lang="en">English inside.</span></p>
<svg xmlns="http://www.w3.org/2000/svg" width="120" height="60" viewBox="0 0 120 60">
  <image xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="../assets/diagrams/cover.png" width="60" height="60"/>
  <a xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#ns"><text x="70" y="35">top</text></a>
</svg>
<p>Back to <a href="0005.xhtml">ordering</a>.</p>

</body>
</html>

== OEBPS/text/0007.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head>
<title>Footnotes in English</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Footnotes in English</h1>
<p>A claim<sup><a class="noteref" id="fnref-1" href="#fn-1">1</a></sup> and another<sup><a class="noteref" id="fnref-2" href="#fn-2">2</a></sup>, then the first again<sup><a class="noteref" id="fnref-1-2" href="#fn-1">1</a></sup>.</p>
<div class="footnotes"><div class="footnote" id="fn-1"><p><a href="#fnref-1">1</a> A footnote with <code>code</code> and a <a href="https://example.com/">link</a>.</p></div><div class="footnote" id="fn-2"><p><a href="#fnref-2">2</a> A footnote with two paragraphs.</p><p>The second paragraph.</p></div></div>
</body>
</html>

== OEBPS/text/0008.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head>
<title>Colophon</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Colophon</h1>
<p>Built from synthetic text for testing. See <a href="0002.xhtml#scope">the introduction</a>.</p>
</body>
</html>

== OEBPS/assets/css/base.css
body { font-family: sans-serif; line-height: 1.6; }

== OEBPS/assets/css/code.css
pre, code { font-family: monospace; }
pre { white-space: pre-wrap; background: #f4f4f4; }
table { border-collapse: collapse; }
td, th { border: 1px solid #999; padding: 0.2em 0.5em; }

