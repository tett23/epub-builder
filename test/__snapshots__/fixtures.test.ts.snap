<h1 id="ns">Namespaces</h1>
<p xml:lang="ja">日本語の段落。<span lang="en" xml:lang="en">English inside.</span></p>
<svg xmlns="http://www.w3.org/2000/svg" width="120" height="60" viewBox="0 0 120 60">
  <image xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="../assets/diagrams/cover.png" width="60" height="60"/>
