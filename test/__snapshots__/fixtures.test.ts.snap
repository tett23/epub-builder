<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Part I: Basics</h1>
</body>
</html>

== OEBPS/text/0004.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="en" lang="en">
<head>
<title>Directory layout</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Directory layout</h1>
<pre id="tree">project/
  book.toml
  body/
  meta/
  assets/</pre>
<pre><code class="language-toml">title = "x &lt; y &amp;&amp; z"
</code></pre>
<ol>
<li>Write <code>book.toml</code>.</li>
<li>Add documents to <code>body/</code>.
<ul>
<li>Nested list item.</li>
<li>Another one.</li>
</ul>
</li>
<li>Build.</li>
</ol>
<blockquote>
<p><strong>Note:</strong> a blockquote with a <a href="0002.xhtml">link back</a>.</p>
</blockquote>
</body>
</html>

== OEBPS/text/0005.xhtml
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="en" lang="en">
<head>
<title>Ordering</title>
<link rel="stylesheet" type="text/css" href="../assets/css/base.css"/>
<link rel="stylesheet" type="text/css" href="../assets/css/code.css"/>
</head>
<body>
<h1>Ordering</h1>
<table>
  <thead><tr><th>Name</th><th>Position</th></tr></thead>
  <tbody><tr><td><code>01-a.md</code></td><td>1
  </td></tr><tr><td><code>02-b.md</code></td><td>2
  </td></tr><tr><td><code>10-c.md</code></td><td>3
</td></tr></tbody></table>
<p>Names are compared by code point — not “naturally”.
</p><p><img src="../assets/diagrams/flow.svg" alt="flow"/>
</p>
</body>
</html>

